{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ─── Configuración SMTP ────────────────────────────────────────────────────
  // IMPORTANTE: En producción, mover estas credenciales a variables de entorno
  // o a Azure Key Vault. NUNCA subir credenciales reales a Git.
  "ConfiguracionCorreo": {
    "ServidorSmtp": "smtp.gmail.com",
    "Puerto": 587,
    "UsarSsl": true,
    "CorreoRemitente": "notificaciones@asiloanuevavida.com",
    "NombreRemitente": "Asilo de Ancianos Cabeza de Algodón",
    "Usuario": "tu_correo@gmail.com",
    "Contrasena": "tu_contrasena_de_aplicacion",

    // Tiempo máximo de espera para el envío (en segundos)
    "TimeoutSegundos": 30,

    // En modo de prueba, NO se envían correos reales.
    // Los correos se registran en el log solamente.
    "ModoDebug": true
  },

  // ─── Configuración del microservicio ──────────────────────────────────────
  "Microservicio": {
    "Nombre": "NotificacionesService",
    "Version": "1.0.0",
    "Proyecto": "Sistema de Gestión — Asilo de Ancianos Cabeza de Algodón",

    // Clave API interna para que solo el backend Node.js pueda consumir este servicio
    // En producción cambiar por un valor aleatorio seguro (GUID o similar)
    "ClaveApi": "asilo-nueva-vida-2025-notificaciones-key"
  },

  "Urls": "http://0.0.0.0:5050"
}
